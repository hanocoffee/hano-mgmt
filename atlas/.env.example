# Atlas Market Research Engine configuration
# Copy to .env and adjust as needed.

# Path to the SQLite database file (':memory:' for ephemeral)
ATLAS_DB_PATH=data/atlas.db

# Log level: debug | info | warn | error
ATLAS_LOG_LEVEL=info

# Analyzer implementation to use (only 'mock' for now;
# an LLM-backed analyzer will be added here later)
ATLAS_ANALYZER=mock
