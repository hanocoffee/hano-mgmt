# Atlas Market Research Engine configuration
# Copy to .env and adjust as needed.

# Path to the SQLite database file (':memory:' for ephemeral)
ATLAS_DB_PATH=data/atlas.db

# Log level: debug | info | warn | error
ATLAS_LOG_LEVEL=info

# Analyzer implementation to use: mock | openai
ATLAS_ANALYZER=mock

# --- Required when ATLAS_ANALYZER=openai ---
# OPENAI_API_KEY=sk-...
# Model to use for analysis
# ATLAS_OPENAI_MODEL=gpt-4o-mini
# Override for OpenAI-compatible endpoints (Azure, local proxy, ...)
# ATLAS_OPENAI_BASE_URL=https://api.openai.com/v1
